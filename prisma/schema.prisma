generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Cargo {
  estudante
  professor
}

enum MaterialContentType {
  text
  video_link
  file
}

enum MaterialTargetType {
  class
  student
}

enum MaterialLogAction {
  created
  updated
  deleted
  downloaded
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  city         String   @map("city")
  cargo        Cargo
  createdAt    DateTime @default(now()) @map("created_at")

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?
  materialDeliveryLogs MaterialDeliveryLog[]

  @@map("users")
}

model School {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  gre  String?
  city String?

  classes              ClassGroup[]
  studentProfiles      StudentProfile[]
  teacherAssignments   TeacherSchoolAssignment[]
  educationalMaterials EducationalMaterial[]

  @@map("schools")
}

model ClassGroup {
  id               String @id @default(uuid()) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  grade            String
  classIdentifier  String @map("class_identifier")
  label            String

  school              School @relation(fields: [schoolId], references: [id])
  studentProfiles     StudentProfile[]
  teacherAssignments  TeacherClassAssignment[]
  materialRecipients  MaterialRecipient[]

  @@unique([schoolId, grade, classIdentifier])
  @@map("classes")
}

model StudentProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId  String @map("class_id") @db.Uuid
  xp       Int    @default(0)
  level    Int    @default(1)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School     @relation(fields: [schoolId], references: [id])
  class  ClassGroup @relation(fields: [classId], references: [id])
  materialRecipients MaterialRecipient[]
  materialReads      MaterialRead[]

  @@map("students")
}

model TeacherProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherClassAssignment[]
  schools     TeacherSchoolAssignment[]
  materials   EducationalMaterial[]
  attachments MaterialAttachment[]

  @@map("teachers")
}

model TeacherSchoolAssignment {
  teacherId String @map("teacher_id") @db.Uuid
  schoolId  String @map("school_id") @db.Uuid

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School         @relation(fields: [schoolId], references: [id])

  @@id([teacherId, schoolId])
  @@map("teacher_schools")
}

model TeacherClassAssignment {
  teacherId String @map("teacher_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   ClassGroup     @relation(fields: [classId], references: [id])

  @@id([teacherId, classId])
  @@map("teacher_classes")
}

model EducationalMaterial {
  id          String              @id @default(uuid()) @db.Uuid
  teacherId   String              @map("teacher_id") @db.Uuid
  schoolId    String              @map("school_id") @db.Uuid
  title       String
  description String
  discipline  String
  contentType MaterialContentType @map("content_type")
  bodyText    String?             @map("body_text")
  videoUrl    String?             @map("video_url")
  sentAt      DateTime            @map("sent_at")
  deletedAt   DateTime?           @map("deleted_at")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  teacher    TeacherProfile      @relation(fields: [teacherId], references: [id])
  school     School              @relation(fields: [schoolId], references: [id])
  recipients MaterialRecipient[]
  attachments MaterialAttachment[]
  deliveryLogs MaterialDeliveryLog[]
  reads      MaterialRead[]

  @@index([teacherId, sentAt])
  @@map("educational_materials")
}

model MaterialRead {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String   @map("material_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  readAt     DateTime @default(now()) @map("read_at")

  material EducationalMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  student  StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, materialId])
  @@index([studentId, readAt])
  @@map("material_reads")
}

model MaterialAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  materialId String?  @map("material_id") @db.Uuid
  teacherId  String   @map("teacher_id") @db.Uuid
  fileName   String   @map("file_name")
  mimeType   String   @map("mime_type")
  sizeBytes  BigInt   @map("size_bytes")
  storageKey String   @map("storage_key")
  checksum   String?
  createdAt  DateTime @default(now()) @map("created_at")

  material EducationalMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  teacher  TeacherProfile       @relation(fields: [teacherId], references: [id])

  @@index([teacherId, materialId])
  @@map("material_attachments")
}

model MaterialDeliveryLog {
  id           String            @id @default(uuid()) @db.Uuid
  materialId   String            @map("material_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  action       MaterialLogAction
  metadata     Json?
  createdAt    DateTime          @default(now()) @map("created_at")

  material EducationalMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  actor      User                @relation(fields: [actorUserId], references: [id])

  @@index([materialId, createdAt])
  @@map("material_delivery_logs")
}

model MaterialRecipient {
  id         String             @id @default(uuid()) @db.Uuid
  materialId String             @map("material_id") @db.Uuid
  targetType MaterialTargetType @map("target_type")
  classId    String             @map("class_id") @db.Uuid
  studentId  String?            @map("student_id") @db.Uuid

  material EducationalMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  class    ClassGroup          @relation(fields: [classId], references: [id])
  student  StudentProfile?     @relation(fields: [studentId], references: [id])

  @@index([studentId])
  @@map("material_recipients")
}
