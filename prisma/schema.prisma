generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Cargo {
  estudante
  professor
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  city         String   @map("city")
  cargo        Cargo
  createdAt    DateTime @default(now()) @map("created_at")

  studentProfile StudentProfile?
  teacherProfile TeacherProfile?

  @@map("users")
}

model School {
  id   String  @id @default(uuid()) @db.Uuid
  name String
  gre  String?
  city String?

  classes           ClassGroup[]
  studentProfiles     StudentProfile[]
  teacherAssignments  TeacherSchoolAssignment[]

  @@map("schools")
}

model ClassGroup {
  id               String @id @default(uuid()) @db.Uuid
  schoolId         String @map("school_id") @db.Uuid
  grade            String
  classIdentifier  String @map("class_identifier")
  label            String

  school           School @relation(fields: [schoolId], references: [id])
  studentProfiles  StudentProfile[]
  teacherAssignments TeacherClassAssignment[]

  @@unique([schoolId, grade, classIdentifier])
  @@map("classes")
}

model StudentProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId  String @map("class_id") @db.Uuid
  xp       Int    @default(0)
  level    Int    @default(1)

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School     @relation(fields: [schoolId], references: [id])
  class  ClassGroup @relation(fields: [classId], references: [id])

  @@map("students")
}

model TeacherProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherClassAssignment[]
  schools     TeacherSchoolAssignment[]

  @@map("teachers")
}

model TeacherSchoolAssignment {
  teacherId String @map("teacher_id") @db.Uuid
  schoolId  String @map("school_id") @db.Uuid

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School         @relation(fields: [schoolId], references: [id])

  @@id([teacherId, schoolId])
  @@map("teacher_schools")
}

model TeacherClassAssignment {
  teacherId String @map("teacher_id") @db.Uuid
  classId   String @map("class_id") @db.Uuid

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class   ClassGroup     @relation(fields: [classId], references: [id])

  @@id([teacherId, classId])
  @@map("teacher_classes")
}
