NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=

# PostgreSQL local
DATABASE_URL="postgresql://postgres:root@localhost:5432/visionedu?schema=public"

# JWT (mínimo 32 caracteres; apenas servidor)
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_EXPIRES_IN_STUDENT=28800
JWT_EXPIRES_IN_TEACHER=86400

# Armazenamento de anexos (materiais educacionais)
# local: grava em ./uploads/ (gitignored) — padrão para desenvolvimento
# s3: AWS S3 ou compatível (R2, MinIO) — requer credenciais abaixo
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=
UPLOAD_MAX_BYTES=10485760

# S3 (somente quando STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# YouTube Data API v3 — busca de vídeos para trilhas de aprendizagem
YOUTUBE_API_KEY=

# n8n — resolução com IA (questões ENEM)
# URL do webhook do fluxo local (ex.: http://localhost:5678/webhook/enem-ai-resolution)
N8N_ENEM_AI_RESOLUTION_WEBHOOK_URL=
# n8n — geração de trilha de aprendizagem personalizada
# URL do webhook (ex.: http://localhost:5678/webhook/learning-path-generation)
N8N_LEARNING_PATH_WEBHOOK_URL=
# Segredo compartilhado (opcional; enviado no header X-Webhook-Secret)
N8N_WEBHOOK_SECRET=
# Timeout em ms para aguardar resposta do n8n (padrão: 90000)
N8N_WEBHOOK_TIMEOUT_MS=90000
